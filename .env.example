# Banco (Neon/Postgres)
DATABASE_URL=postgresql://usuario:senha@host/neondb?sslmode=require

# NextAuth — gere com: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Login com Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Quem pode ENTRAR pelo Google sem cadastro prévio (separe por vírgula). Vazio = só quem já tem usuário.
ALLOWED_EMAIL_DOMAINS=rondonopolis.mt.gov.br
ALLOWED_EMAILS=

# Editor (TinyMCE Cloud) — https://www.tiny.cloud (restrinja ao seu domínio no painel)
NEXT_PUBLIC_TINYMCE_API_KEY=

# Numeração: último número usado no sistema anterior e o ANO a que ele se refere.
# Em outros anos a contagem começa em 001.
OFICIO_ULTIMO_NUMERO_LEGADO=65
OFICIO_ANO_LEGADO=2026
OFICIO_SUFIXO=SCFC/ADMINISTRAÇÃO

# Seed (opcional)
SEED_ADMIN_EMAIL=admin@scfc.com
SEED_ADMIN_PASSWORD=
